{
  "name": "whisper-electron-app",
  "version": "1.2.0",
  "description": "TalaTrace — private audio transcription with local Whisper and Parakeet models",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawn002/talatrace.git"
  },
  "homepage": "https://github.com/pawn002/talatrace#readme",
  "bugs": {
    "url": "https://github.com/pawn002/talatrace/issues"
  },
  "main": "dist/electron/main.js",
  "scripts": {
    "test": "npm --prefix frontend test -- --runInBand && npm run test:electron",
    "test:electron": "npm run build:electron && node --test tests/electron/*.test.cjs",
    "test:speech-activity": "npm run build:electron && node tests/electron/speech-activity-native.cjs",
    "test:interview-smoke": "npm run build && electron tests/electron/interview-smoke.cjs",
    "preview:workflow": "npm run build && electron tests/electron/workflow-preview.cjs",
    "start": "npm run build && electron .",
    "build": "npm run build:frontend && npm run build:electron",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "tsc -p electron",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "cd frontend && npm run start",
    "dev:electron": "npm run build:electron && wait-on tcp:4200 && npx electron . --dev",
    "setup": "npm ci && npm run install:all && node scripts/setup-whisper.js",
    "install:all": "npm --prefix frontend ci",
    "build:whisper": "node scripts/build-whisper.js",
    "setup:transcribe": "node scripts/setup-transcribe.cjs",
    "system-info": "node scripts/system-info.js",
    "build:whisper-variants": "node scripts/build-whisper-variants.js",
    "build:whisper-baseline": "node scripts/build-whisper-variants.js --variant=baseline",
    "build:whisper-avx512": "node scripts/build-whisper-variants.js --variant=avx512",
    "build:whisper-sycl": "node scripts/build-whisper-variants.js --variant=sycl",
    "build:whisper-openvino": "node scripts/build-whisper-variants.js --variant=openvino",
    "benchmark": "node scripts/benchmark-variants.js",
    "eval:speech:prepare": "python scripts/prepare-speech-eval.py",
    "eval:speech": "npm run build:electron && electron scripts/evaluate-speech-models.cjs",
    "clean": "node -e \"['dist','frontend/dist','frontend/.angular'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "clean:release": "node -e \"require('fs').rmSync('release',{recursive:true,force:true})\"",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "version:patch": "node scripts/prepare-version.cjs patch",
    "version:minor": "node scripts/prepare-version.cjs minor",
    "version:major": "node scripts/prepare-version.cjs major",
    "version:sync": "node scripts/sync-version.js",
    "release": "npm run version:sync && git push --follow-tags",
    "release:interactive": "node scripts/release.js"
  },
  "keywords": [
    "electron",
    "whisper",
    "speech-to-text",
    "angular"
  ],
  "author": "John R.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "typescript": "~5.5.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.yourcompany.whisper-electron",
    "productName": "TalaTrace",
    "electronCompile": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "transcribe-runtime",
        "to": "transcribe-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "ggml-silero-v5.1.2.bin"
        ]
      },
      {
        "from": "ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "bin/ffmpeg.exe",
          "bin/ffmpeg",
          "licenses/**/*",
          "version.json"
        ]
      }
    ],
    "icon": "build/icon.png",
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Record interview answers for private, on-device transcription."
      },
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "extraResources": [
        {
          "from": "whisper.cpp/build-vulkan/bin",
          "to": "whisper.cpp/build-vulkan/bin",
          "filter": [
            "whisper-cli.exe",
            "whisper-vad-speech-segments.exe",
            "whisper.dll",
            "ggml.dll",
            "ggml-base.dll",
            "ggml-cpu.dll",
            "ggml-vulkan.dll"
          ]
        },
        {
          "from": "whisper.cpp/build-baseline/bin/Release",
          "to": "whisper.cpp/build/bin/Release",
          "filter": [
            "whisper-cli.exe",
            "whisper-vad-speech-segments.exe",
            "whisper.dll",
            "ggml.dll",
            "ggml-base.dll",
            "ggml-cpu.dll"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "extraResources": [
        {
          "from": "whisper.cpp/build-baseline/bin",
          "to": "whisper.cpp/build/bin",
          "filter": [
            "whisper-cli",
            "whisper-vad-speech-segments",
            "licenses/**/*"
          ]
        }
      ],
      "artifactName": "TalaTrace-${version}-linux-${arch}.${ext}",
      "maintainer": "John R. <pawn002@users.noreply.github.com>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64",
        "libgbm1",
        "libstdc++6",
        "libgcc-s1",
        "libc6 (>= 2.39)",
        "apparmor (>= 4.0)"
      ],
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh",
      "fpm": [
        "--config-files",
        "/etc/apparmor.d/talatrace",
        "build/linux/talatrace.apparmor=/etc/apparmor.d/talatrace",
        "node_modules/electron-builder/LICENSE=/usr/share/doc/whisper-electron-app/LICENSE-electron-builder"
      ]
    }
  }
}
